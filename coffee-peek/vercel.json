{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/downloads/:path*",
      "destination": "https://api.coffeepeek.by/downloads/:path*",
      "permanent": false
    },
    {
      "source": "/download",
      "destination": "/settings",
      "permanent": true
    },
    {
      "source": "/cities/:slug",
      "destination": "/shops?citySlug=:slug",
      "permanent": true
    },
    {
      "source": "/coffee-zones/:slug",
      "destination": "/map",
      "permanent": true
    }
  ],
  "rewrites": [
    {"source": "/.well-known/assetlinks.json", "destination": "/.well-known/assetlinks.json"},
    {"source": "/coffee-shops/new", "destination": "/index.html"},
    {"source": "/roasters/new", "destination": "/index.html"},
    {"source": "/coffee-shops/:shopId", "destination": "/api/public-page?page=address&kind=shops&segment=:shopId&path=/coffee-shops/:shopId"},
    {"source": "/roasters/:roasterId", "destination": "/api/public-page?page=address&kind=roasters&segment=:roasterId&path=/roasters/:roasterId"},
    {"source": "/users/:userId", "destination": "/api/public-page?page=address&kind=users&segment=:userId&path=/users/:userId"},
    { "source": "/", "destination": "/api/public-page?page=home" },
    { "source": "/shops", "destination": "/api/public-page?page=shops" },
    { "source": "/shops/:shopId", "destination": "/api/public-page?page=shop&shopId=:shopId" },
    { "source": "/download/android", "destination": "https://api.coffeepeek.by/download/android" },
    { "source": "/download/apk", "destination": "https://api.coffeepeek.by/download/apk" },
    { "source": "/download/ios", "destination": "https://api.coffeepeek.by/download/ios" },
    { "source": "/:path*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(self)" }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/fonts/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
