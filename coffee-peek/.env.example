# Browser-visible project token (phc_...), never a personal API key (phx_...).
VITE_POSTHOG_KEY=
# Match the project's region: https://eu.i.posthog.com or https://us.i.posthog.com
VITE_POSTHOG_HOST=https://eu.i.posthog.com
# Enable only when deliberately testing local analytics.
VITE_POSTHOG_ENABLE_DEV=false
