{
  "meta": {
    "name": "CoffeePeek Design System",
    "version": "1.1.0",
    "platform": "cross-platform",
    "webUnit": "px",
    "androidUnit": "dp",
    "note": "Generated from tokens.ts and components.ts. Colors use CSS notation; Android resources are not bundled."
  },
  "brand": {
    "primary": "#EAB308",
    "primaryHover": "#FACC15",
    "primaryDark": "#CA8A04",
    "primaryLight": "#FEF3C7",
    "goldWarm": "#D4A84B",
    "goldWarmHover": "#B68A2E",
    "goldWarmSoft": "#F8F1DD"
  },
  "semantic": {
    "success": "#22C55E",
    "error": "#EF4444",
    "warning": "#EAB308",
    "info": "#3B82F6"
  },
  "typography": {
    "fontFamily": {
      "display": "Manrope",
      "body": "Manrope"
    },
    "fontWeight": {
      "ultralight": 200,
      "light": 300,
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "extrabold": 800,
      "black": 900
    },
    "fontSize": {
      "xs": 12,
      "sm": 13,
      "base": 14,
      "md": 15,
      "lg": 16,
      "xl": 20,
      "2xl": 24,
      "3xl": 30,
      "4xl": 36,
      "hero": 88
    },
    "lineHeight": {
      "tight": 0.92,
      "snug": 0.95,
      "normal": 1.15,
      "relaxed": 1.5
    },
    "letterSpacing": {
      "wordmark": -0.045,
      "hero": -0.01,
      "heading": -0.02,
      "label": -0.025,
      "normal": 0
    }
  },
  "spacing": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "7": 28,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64,
    "18": 72
  },
  "borderRadius": {
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 20,
    "2xl": 24,
    "3xl": 26,
    "4xl": 28,
    "full": 9999
  },
  "borderWidth": {
    "thin": 1,
    "medium": 2
  },
  "shadow": {
    "buttonPrimary": "0 4px 6px -4px rgba(180, 140, 75, 0.2), 0 10px 15px -3px rgba(180, 140, 75, 0.2)",
    "card": "0 3px 14px rgba(0,0,0,.08)",
    "cardHover": "0 12px 32px rgba(0,0,0,.22)",
    "dropdown": "0 25px 50px -12px rgba(0, 0, 0, 0.25)",
    "focusRing": "0 0 0 3px rgba(234, 179, 8, 0.1)",
    "goldGlow": "0 4px 12px rgba(234, 179, 8, 0.18)"
  },
  "opacity": {
    "disabled": 0.5,
    "primaryTint10": 0.1,
    "primaryTint20": 0.2,
    "primaryTint30": 0.3,
    "primaryTint40": 0.4,
    "primaryTint50": 0.5,
    "surfaceBackdrop": 0.88,
    "surfaceBackdropDark": 0.7
  },
  "animation": {
    "durationFast": 150,
    "durationNormal": 200,
    "durationSlow": 300,
    "durationToast": 5000,
    "easingDefault": "ease",
    "buttonPressScale": 0.98
  },
  "layout": {
    "headerHeight": 64,
    "headerHeightLanding": 64,
    "maxContentWidth": 1280,
    "contentPaddingX": 16,
    "contentPaddingXDesktop": 32
  },
  "themes": {
    "light": {
      "background": "#FAFAF9",
      "surface": "#FFFFFF",
      "surfaceAlt": "#F9F8F6",
      "card": "#FFFFFF",
      "input": "#FFFFFF",
      "badge": "#F3F4F6",
      "textPrimary": "#1C1917",
      "textSecondary": "#78716C",
      "textMuted": "#75706B",
      "textTertiary": "#6B7280",
      "textOnPrimary": "#1A1412",
      "border": "#E7E5E4",
      "borderSubtle": "#E5E1DA",
      "borderHover": "#D1D5DB",
      "overlay": "rgba(0, 0, 0, 0.5)",
      "scrollbarTrack": "#F5F4F2",
      "scrollbarThumb": "#D1D5DB"
    },
    "dark": {
      "background": "#1A1412",
      "surface": "#2D241F",
      "surfaceAlt": "#2D241F",
      "card": "#2D241F",
      "input": "#1A1412",
      "badge": "#2D241F",
      "textPrimary": "#FFFFFF",
      "textSecondary": "#A39E93",
      "textMuted": "#A8A8A8",
      "textTertiary": "#5C544F",
      "textOnPrimary": "#1A1412",
      "border": "#3D2F28",
      "borderSubtle": "#3D2F28",
      "borderHover": "#4A3D35",
      "overlay": "rgba(0, 0, 0, 0.5)",
      "scrollbarTrack": "#1A1412",
      "scrollbarThumb": "#3D2F28"
    }
  },
  "components": {
    "button": {
      "height": "auto",
      "paddingVertical": 10,
      "paddingHorizontal": 16,
      "borderRadius": 12,
      "fontSize": 16,
      "lineHeight": 24,
      "fontWeight": 600,
      "fontFamily": "Manrope",
      "gap": 8,
      "variants": {
        "primary": {
          "background": "brand.primary",
          "text": "theme.textOnPrimary",
          "backgroundHover": "brand.primaryHover",
          "shadow": "shadow.buttonPrimary"
        },
        "secondary": {
          "background": "theme.surface",
          "text": "theme.textPrimary",
          "border": "theme.border",
          "backgroundHover": "theme.border",
          "light": {
            "background": "#F3F4F6",
            "text": "#111827",
            "border": "#D1D5DB",
            "backgroundHover": "#E5E7EB"
          }
        },
        "ghost": {
          "background": "transparent",
          "text": "theme.textSecondary",
          "textHover": "theme.textPrimary",
          "light": {
            "text": "#4B5563",
            "textHover": "#111827"
          }
        }
      },
      "states": {
        "disabledOpacity": 0.5,
        "pressScale": 0.98,
        "focusRingWidth": 2,
        "focusRingColor": "brand.primary",
        "focusRingOpacity": 0.5,
        "focusRingOffset": 2
      }
    },
    "input": {
      "height": "auto",
      "paddingVertical": 16,
      "paddingHorizontal": 16,
      "paddingHorizontalWithIcon": 48,
      "borderRadius": 26,
      "fontSize": 16,
      "lineHeight": 24,
      "labelFontSize": 14,
      "labelFontWeight": 500,
      "borderWidth": 0,
      "states": {
        "defaultBorder": "theme.border",
        "defaultBorderLight": "#E5E7EB",
        "focusBorder": "brand.primary",
        "focusRingWidth": 3,
        "focusRingColor": "brand.primary",
        "focusRingOpacity": 0.1,
        "placeholder": "theme.textTertiary"
      }
    },
    "select": {
      "minHeight": 56,
      "paddingVertical": 16,
      "paddingHorizontal": 16,
      "paddingHorizontalWithIcon": 48,
      "borderRadius": 16,
      "fontSize": 16,
      "labelFontSize": 12,
      "borderWidth": 2,
      "dropdownMaxHeight": 256,
      "dropdownBorderRadius": 16,
      "states": {
        "defaultBorder": "theme.border",
        "defaultBorderLight": "#E5E7EB",
        "focusBorder": "brand.primary",
        "focusShadow": "0 10px 15px -3px rgba(234,179,8,.1), 0 4px 6px -4px rgba(234,179,8,.1)",
        "selectedItemBackground": "brand.primary",
        "selectedItemBackgroundOpacity": 0.1,
        "hoverItemBackground": "theme.border",
        "hoverItemBackgroundLight": "#F3F4F6"
      }
    },
    "card": {
      "borderRadius": 28,
      "borderWidth": 1,
      "padding": 16,
      "paddingTop": 12,
      "photoAspectRatio": "16:9",
      "hoverTranslateY": -2,
      "hoverTransitionMs": 150,
      "photoHoverScale": 1.035,
      "photoTransitionMs": 500,
      "states": {
        "defaultBorder": "theme.border",
        "hoverBorder": "brand.primary",
        "hoverBorderOpacity": 0.4392156862745098,
        "shadow": "shadow.card",
        "shadowHover": "shadow.cardHover"
      }
    },
    "checkInCard": {
      "borderRadius": 20,
      "borderWidth": 1,
      "padding": 16,
      "paddingDesktop": 20,
      "avatarSize": 48,
      "authorFontSize": 14,
      "dateFontSize": 12,
      "dateFontSizeDesktop": 14,
      "shopFontSize": 20,
      "starSize": 20,
      "bodyFontSize": 16,
      "bodyLineHeight": 1.55,
      "drink": {
        "placement": "bottom-right",
        "layout": "horizontal",
        "verticalAlign": "center",
        "photoSize": 80,
        "photoFit": "contain",
        "fallbackIconSize": 32,
        "fontSize": 14
      },
      "photos": {
        "borderRadius": 12,
        "gap": 4,
        "singleAspectRatio": "3:2",
        "collageAspectRatio": "5:3",
        "fourAspectRatio": "5:4"
      },
      "reaction": {
        "iconSize": 26,
        "minHeight": 44,
        "color": "#EF4444",
        "fontSize": 14
      }
    },
    "toast": {
      "minWidth": 320,
      "maxWidth": 448,
      "padding": 16,
      "borderRadius": 12,
      "fontSize": 14,
      "fontWeight": 500,
      "gap": 12,
      "durationMs": 5000,
      "iconSize": 20,
      "imageSize": 80
    },
    "header": {
      "height": 64,
      "heightLanding": 64,
      "backdropBlur": 24,
      "mobileNavigation": "top-popover",
      "mobileMenuButtonSize": 44,
      "mobileMenuItemMinHeight": 48,
      "logoSize": 52,
      "logoBorderRadius": 15,
      "navButtonMinHeight": 34,
      "navButtonPaddingVertical": 0,
      "navButtonPaddingHorizontal": 14,
      "navButtonBorderRadius": 999,
      "navFontSize": 14,
      "navFontWeight": 600,
      "avatarSize": 34,
      "avatarSizeLarge": 38
    },
    "badge": {
      "paddingVertical": 4,
      "paddingHorizontal": 12,
      "borderRadius": 9999,
      "fontSize": 12,
      "fontWeight": 500
    },
    "loader": {
      "defaultSize": 48,
      "buttonSize": 20,
      "color": "brand.primary",
      "borderWidthRatio": 16,
      "minBorderWidth": 2,
      "borderWidthRounding": "round"
    },
    "typographyStyles": {
      "wordmark": {
        "fontFamily": "Manrope",
        "fontWeight": 800,
        "fontSize": 20,
        "letterSpacing": -0.045
      },
      "hero": {
        "fontFamily": "Manrope",
        "fontWeight": 900,
        "fontSize": 88,
        "letterSpacing": -0.05,
        "lineHeight": 0.95
      },
      "h1": {
        "fontFamily": "Manrope",
        "fontWeight": 700,
        "fontSize": 36,
        "letterSpacing": -0.02
      },
      "h2": {
        "fontFamily": "Manrope",
        "fontWeight": 700,
        "fontSize": 24,
        "letterSpacing": -0.025
      },
      "h3": {
        "fontFamily": "Manrope",
        "fontWeight": 700,
        "fontSize": 20
      },
      "body": {
        "fontFamily": "Manrope",
        "fontWeight": 400,
        "fontSize": 16
      },
      "bodySmall": {
        "fontFamily": "Manrope",
        "fontWeight": 400,
        "fontSize": 14
      },
      "caption": {
        "fontFamily": "Manrope",
        "fontWeight": 400,
        "fontSize": 12
      },
      "label": {
        "fontFamily": "Manrope",
        "fontWeight": 500,
        "fontSize": 14
      }
    }
  }
}
