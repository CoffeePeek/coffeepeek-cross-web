{
  "$schema": "./tokens.schema.json",
  "meta": {
    "name": "CoffeePeek Design System",
    "version": "1.0.0",
    "platform": "cross-platform",
    "webUnit": "px",
    "androidUnit": "dp",
    "note": "Web px values map 1:1 to Android dp at standard density"
  },
  "brand": {
    "primary": "#EAB308",
    "primaryHover": "#FACC15",
    "primaryDark": "#CA8A04",
    "primaryLight": "#FEF3C7",
    "goldWarm": "#D4A84B",
    "goldWarmHover": "#B68A2E",
    "goldWarmSoft": "#F8F1DD"
  },
  "semantic": {
    "success": "#22C55E",
    "error": "#EF4444",
    "warning": "#EAB308",
    "info": "#3B82F6"
  },
  "themes": {
    "light": {
      "background": "#FAFAF9",
      "surface": "#FFFFFF",
      "surfaceAlt": "#F9F8F6",
      "card": "#FFFFFF",
      "input": "#FFFFFF",
      "badge": "#F3F4F6",
      "textPrimary": "#1C1917",
      "textSecondary": "#78716C",
      "textMuted": "#75706B",
      "textTertiary": "#6B7280",
      "textOnPrimary": "#1A1412",
      "border": "#E7E5E4",
      "borderSubtle": "#E5E1DA",
      "borderHover": "#D1D5DB",
      "overlay": "#80000000",
      "scrollbarTrack": "#F5F4F2",
      "scrollbarThumb": "#D1D5DB"
    },
    "dark": {
      "background": "#1A1412",
      "surface": "#2D241F",
      "surfaceAlt": "#2D241F",
      "card": "#2D241F",
      "input": "#1A1412",
      "badge": "#2D241F",
      "textPrimary": "#FFFFFF",
      "textSecondary": "#A39E93",
      "textMuted": "#A8A8A8",
      "textTertiary": "#5C544F",
      "textOnPrimary": "#1A1412",
      "border": "#3D2F28",
      "borderSubtle": "#3D2F28",
      "borderHover": "#4A3D35",
      "overlay": "#80000000",
      "scrollbarTrack": "#1A1412",
      "scrollbarThumb": "#3D2F28"
    }
  },
  "typography": {
    "fontFamily": {
      "display": "Manrope",
      "body": "Manrope"
    },
    "fontWeight": {
      "ultralight": 200,
      "light": 300,
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "extrabold": 800,
      "black": 900
    },
    "fontSize": {
      "xs": 12,
      "sm": 13,
      "base": 14,
      "md": 15,
      "lg": 16,
      "xl": 20,
      "2xl": 24,
      "3xl": 30,
      "4xl": 36,
      "hero": 88
    },
    "lineHeight": {
      "tight": 0.92,
      "snug": 0.95,
      "normal": 1.15,
      "relaxed": 1.5
    },
    "letterSpacing": {
      "wordmark": -0.045,
      "hero": -0.01,
      "heading": -0.02,
      "label": -0.025,
      "normal": 0
    }
  },
  "spacing": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "7": 28,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64,
    "18": 72
  },
  "borderRadius": {
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 20,
    "2xl": 24,
    "3xl": 26,
    "4xl": 28,
    "full": 9999
  },
  "borderWidth": {
    "thin": 1,
    "medium": 2
  },
  "shadow": {
    "buttonPrimary": "0 4px 6px -4px rgba(180, 140, 75, 0.2), 0 10px 15px -3px rgba(180, 140, 75, 0.2)",
    "card": "inset 0 1px 0 rgba(255, 255, 255, 0.04)",
    "cardHover": "0 8px 24px rgba(0, 0, 0, 0.18), inset 0 1px 0 rgba(255, 255, 255, 0.04)",
    "dropdown": "0 25px 50px -12px rgba(0, 0, 0, 0.25)",
    "focusRing": "0 0 0 3px rgba(234, 179, 8, 0.1)",
    "goldGlow": "0 4px 12px rgba(234, 179, 8, 0.18)"
  },
  "opacity": {
    "disabled": 0.5,
    "primaryTint10": 0.1,
    "primaryTint20": 0.2,
    "primaryTint30": 0.3,
    "primaryTint40": 0.4,
    "primaryTint50": 0.5,
    "surfaceBackdrop": 0.88,
    "surfaceBackdropDark": 0.7
  },
  "animation": {
    "durationFast": 150,
    "durationNormal": 200,
    "durationSlow": 300,
    "durationToast": 5000,
    "easingDefault": "ease",
    "buttonPressScale": 0.98
  },
  "layout": {
    "headerHeight": 64,
    "headerHeightLanding": 72,
    "maxContentWidth": 1280,
    "contentPaddingX": 16,
    "contentPaddingXDesktop": 32
  },
  "components": {
    "button": {
      "height": 40,
      "paddingVertical": 10,
      "paddingHorizontal": 16,
      "borderRadius": 12,
      "fontSize": 16,
      "fontWeight": 600,
      "gap": 8,
      "variants": ["primary", "secondary", "ghost"]
    },
    "input": {
      "minHeight": 52,
      "paddingVertical": 16,
      "paddingHorizontal": 16,
      "borderRadius": 26,
      "fontSize": 16,
      "focusRingWidth": 3
    },
    "select": {
      "minHeight": 56,
      "borderRadius": 16,
      "borderWidth": 2,
      "dropdownMaxHeight": 256
    },
    "card": {
      "borderRadius": 16,
      "padding": 24,
      "photoAspectRatio": "5:3",
      "hoverTranslateY": -3
    },
    "checkInCard": {
      "borderRadius": 20,
      "borderWidth": 1,
      "padding": 16,
      "paddingDesktop": 20,
      "avatarSize": 48,
      "authorFontSize": 14,
      "dateFontSize": 12,
      "dateFontSizeDesktop": 14,
      "shopFontSize": 20,
      "starSize": 20,
      "bodyFontSize": 16,
      "bodyLineHeight": 1.55,
      "drink": {
        "minHeight": 56,
        "borderRadius": 16,
        "photoSize": 44,
        "photoBorderRadius": 12,
        "fontSize": 14
      },
      "photos": {
        "borderRadius": 12,
        "gap": 4,
        "singleAspectRatio": "3:2",
        "collageAspectRatio": "5:3",
        "fourAspectRatio": "5:4"
      },
      "reaction": {
        "iconSize": 26,
        "minHeight": 44,
        "color": "#EF4444",
        "fontSize": 14
      }
    },
    "toast": {
      "minWidth": 320,
      "maxWidth": 448,
      "padding": 16,
      "borderRadius": 12,
      "durationMs": 5000
    },
    "header": {
      "height": 64,
      "logoSize": 40,
      "avatarSize": 30
    },
    "loader": {
      "defaultSize": 48,
      "buttonSize": 20,
      "color": "#EAB308"
    }
  }
}
