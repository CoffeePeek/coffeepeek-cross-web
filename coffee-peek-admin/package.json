{
  "name": "coffee-peek-admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --strictPort",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "jest --runInBand",
    "test:coffee-catalog": "node scripts/verify-coffee-catalog.mjs",
    "test:check-ins": "node scripts/verify-check-ins.mjs",
    "test:discovery-live": "node scripts/verify-live-discovery.mjs",
    "extension:build": "node scripts/build-link-import-extension.mjs",
    "test:link-import": "npm run extension:build && node scripts/verify-link-import.mjs",
    "predev": "npm run extension:build",
    "prebuild": "npm run extension:build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@microsoft/signalr": "^10.0.11",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-query": "^5.90.17",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "maplibre-gl": "^6.11.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.71.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/geojson": "7946.0.16",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.5.0",
    "jest": "^29.7.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29.4.14",
    "typescript": "~5.8.2",
    "vite": "^6.4.2",
    "playwright": "^1.63.0",
    "esbuild": "^0.25.12",
    "jsdom": "^26.1.0",
    "@types/jsdom": "^30.0.0"
  }
}
